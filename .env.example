# Database Configuration
# Leave as SQLite for standard local running, or swap to PostgreSQL
DATABASE_URL=sqlite:///./analytics.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/analytics

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# LLM GenAI Settings
# Provide at least one API key to enable live generation.
# LLM_PROVIDER can be 'gemini' or 'openai'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
